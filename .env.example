# Copy to .env (git-ignored) and fill in. Used by tools/panel.py and by the server outside Home Assistant.

# Home Assistant address WITH the port, and a long-lived token (your profile → Security → Long-lived access tokens)
HA_URL=http://<HA_IP>:8123
HA_TOKEN=

# SSH into Home Assistant OS (app "Terminal & SSH"), for `deploy-app`
HA_SSH=root@<HA_IP>
# HA_SSH_KEY=~/.ssh/id_ed25519
# HA_SSH_PORT=22

# To-do lists used by the Telegram commands (and the panel config)
HA_SHOPPING=todo.shopping
HA_TASKS=todo.tasks

# Telegram group id (a negative number, groups start with -100…) and language of the bot: en | es
TELEGRAM_CHAT_ID=
PANEL_LANG=en

# Optional when running the server outside HA: sync the menu from a URL
# MENU_URL=https://example.org/menu.js
# MENU_ADAPTER=generic
